class Solution {
    
    class UnionFind {
        int[] parent;
        int[] rank;
        
        UnionFind(int n) {
            parent = new int[n];
            rank = new int[n];
            
            for (int i = 0; i < n; i++) {
                parent[i] = i;
            }
        }
        
        // Find with Path Compression
        public int find(int x) {
            if (parent[x] != x) {
                parent[x] = find(parent[x]);
            }
            return parent[x];
        }
        
        // Union by Rank
        public boolean union(int x, int y) {
            int rootX = find(x);
            int rootY = find(y);
            
            if (rootX == rootY) return false;
            
            if (rank[rootX] > rank[rootY]) {
                parent[rootY] = rootX;
            } else if (rank[rootX] < rank[rootY]) {
                parent[rootX] = rootY;
            } else {
                parent[rootY] = rootX;
                rank[rootX]++;
            }
            
            return true;
        }
    }
    
    public int makeConnected(int n, int[][] connections) {
        
        // If not enough cables
        if (connections.length < n - 1) {
            return -1;
        }
        
        UnionFind uf = new UnionFind(n);
        int components = n;
        
        for (int[] conn : connections) {
            if (uf.union(conn[0], conn[1])) {
                components--;
            }
        }
        
        return components - 1;
    }
}
